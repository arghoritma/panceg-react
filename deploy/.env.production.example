# Copy to /etc/dulak/dulak.env on the server. Keep that file readable only by
# the dulak service account; never commit real credentials.
NODE_ENV=production
PORT=4000
HOST=127.0.0.1
APP_URL=https://app.example.com

# Persistent data must live outside the deployed application checkout.
DATABASE_PATH=/srv/dulak/data/app.sqlite
UPLOAD_DIR=/srv/dulak/data/uploads
MIGRATIONS_MODE=cli
SSR=true

MAIL_DRIVER=resend
MAIL_FROM=no-reply@app.example.com
RESEND_API_KEY=
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

RATE_LIMIT_GLOBAL_MAX=200
RATE_LIMIT_GLOBAL_WINDOW=60
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_AUTH_WINDOW=60

# Required when Prometheus is not scraping from loopback.
METRICS_TOKEN=
