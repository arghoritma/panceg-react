# Server
NODE_ENV=development
PORT=4000

# Standalone API server (src/api.ts) — separate process, same database.
# Authenticated with personal bearer tokens managed at /tokens in the dashboard.
API_PORT=4001

# Interface Bun listens on. Use 127.0.0.1 behind a reverse proxy in production.
HOST=0.0.0.0

# Absolute base URL — used for email links and OAuth redirects
APP_URL=http://localhost:4000
DATABASE_PATH=./data/app.sqlite

# 'startup' applies pending migrations during application boot. 'cli' requires
# `bun run db:migrate`, which is recommended for controlled production releases.
MIGRATIONS_MODE=startup 

# Directory where tus upload chunks are stored on disk. 
UPLOAD_DIR=./data/uploads

#Maximum total upload size in bytes (Tus-Max-Size). 0 = unlimited.
TUS_MAX_SIZE=0

# Seconds after which an unfinished upload may be swept (Expiration). 0 = no expiry.
TUS_EXPIRATION_SECONDS=0


# Server-side rendering: true renders pages on the server (hydrate);
# false ships an empty shell and lets the client render from scratch.
SSR=true

# Mail — driver: log | resend | mailtrap
#   log      → prints to console (development default)
#   resend   → https://resend.com
#   mailtrap → https://mailtrap.io (set MAILTRAP_INBOX_ID to use the sandbox endpoint)
MAIL_DRIVER=log
MAIL_FROM=no-reply@example.com
RESEND_API_KEY=
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=

# Google OAuth (optional — login button hidden when unset)
# Register: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <APP_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Rate limiting
#   GLOBAL = per-IP limit on ALL routes (DDoS baseline; excludes /health, /assets/*)
#   AUTH   = stricter per-IP limit on auth endpoints (brute-force protection)
#   MAX    = max requests from one IP within the window
#   WINDOW = window size in seconds; after it elapses the counter resets
# Example: GLOBAL MAX=200 WINDOW=60 → one IP can make up to 200 requests per 60s
#          before receiving HTTP 429 (Too Many Requests).
RATE_LIMIT_GLOBAL_MAX=200
RATE_LIMIT_GLOBAL_WINDOW=60
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_AUTH_WINDOW=60

# Metrics — protect the /metrics Prometheus endpoint.
#   Set a token to require `Authorization: Bearer <token>` on scrapes.
#   Leave empty to restrict /metrics to loopback (localhost) only.
METRICS_TOKEN=
